# Pooled connection used by the running app. Prisma Postgres supplies DATABASE_URL.
DATABASE_URL="postgresql://user:password@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Direct connection to the same database for Prisma migrations. Prisma Postgres supplies POSTGRES_URL.
POSTGRES_URL="postgresql://user:password@db.prisma.io:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-at-least-32-random-characters"
ADMIN_SECRET_KEY="replace-with-a-private-admin-passcode"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EXTENSION_ID="your-chrome-extension-id,another-allowed-extension-id"
